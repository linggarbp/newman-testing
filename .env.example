# Optional: override the base_url every folder talks to.
# Leave blank to use the value from the environment file (environments/local.json).
NEWMAN_BASE_URL=

# What runs and where the artifacts land.
NEWMAN_COLLECTION=collections/sample-api-collection.json
NEWMAN_ENVIRONMENT=environments/local.json
NEWMAN_REPORTERS=cli,json
ARTIFACTS_DIR=test-results
REQUEST_TIMEOUT_MS=10000
ITERATIONS=1

# Optional: run a single folder (scenario) instead of all of them.
# NEWMAN_FOLDER=
